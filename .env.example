# Copy this file to `.env.local` and fill in your Supabase project values.
# `.env.local` is gitignored — never commit real values.
#
# Where to find these: Supabase dashboard → Project Settings → API.
# Both are safe to ship in client builds: the anon key is a PUBLIC key whose
# access is constrained by Row Level Security (see SETUP.md). It is NOT the
# service_role key — never put service_role in client env.

# Project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Public anon / publishable key (the long JWT-looking string)
VITE_SUPABASE_ANON_KEY=

# Optional: restrict the email one-time-code login to one domain (no leading @).
# Leave blank to allow any email address. The hard enforcement is the RLS
# policies in SETUP.md; this just gates the in-app sign-in UX.
VITE_ALLOWED_EMAIL_DOMAIN=clay.com

# ---------------------------------------------------------------------------
# SERVER-ONLY vars for the /api/* serverless functions (NOT VITE_*, so they are
# never shipped to the browser). Set these in Vercel → Settings → Env Vars.
# Only needed locally if you test the functions with `vercel dev`.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://abcdefgh.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   # the service_role secret — keep server-side only
# ALLOWED_EMAIL_DOMAIN=clay.com
# APP_URL=https://forecasting.chris-apis.xyz

# AI (Suggest tips + Ask AI) — calls the Claude API server-side. Until this key
# is set, the AI features show a "coming soon" state and stay disabled.
# ANTHROPIC_API_KEY=           # your Claude API key
# AI_MODEL=claude-sonnet-4-6   # optional; any current Claude model id
